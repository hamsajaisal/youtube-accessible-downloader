<Window x:Class="YoutubeDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube Accessible Downloader" Height="650" Width="850"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F7">
    
    <Window.Resources>
        <!-- Modern clean styles for WPF Controls -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#E1E1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#C2C2C7"/>
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="-2" Stroke="Black" StrokeThickness="1.5" StrokeDashArray="1 2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#C2C2C7"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,10,0,10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#D6D6DB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Mode Toggle -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="YouTube Accessible Downloader" FontSize="20" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
            <CheckBox Name="ChkAdvancedMode" Content="Advanced Settings Mode" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="False" Checked="ChkAdvancedMode_Changed" Unchecked="ChkAdvancedMode_Changed" AutomationProperties.Name="Advanced Settings Mode Toggle"/>
        </DockPanel>

        <!-- Main Tabs Control -->
        <TabControl Grid.Row="1" Name="MainTabControl" Background="White" BorderBrush="#D6D6DB" BorderThickness="1" SelectionChanged="MainTabControl_SelectionChanged">
            
            <!-- TAB 1: DOWNLOADER -->
            <TabItem Header="_Downloader" Name="TabItemDownloader">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        
                        <!-- URL Input Group -->
                        <GroupBox Header="Analyze YouTube Link" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.ColumnSpan="2" Target="{Binding ElementName=TxtUrl}" Content="Paste a YouTube Video or Playlist Link:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Grid.Row="1" Grid.Column="0" Name="TxtUrl" Margin="0,0,10,0" VerticalAlignment="Center" AutomationProperties.Name="YouTube URL Link Box" KeyDown="TxtUrl_KeyDown"/>
                                <Button Grid.Row="1" Grid.Column="1" Name="BtnAnalyze" Content="Analyze Link" Style="{StaticResource PrimaryButton}" Click="BtnAnalyze_Click" AutomationProperties.Name="Analyze Link Button"/>
                            </Grid>
                        </GroupBox>

                        <!-- Loading Indicator -->
                        <TextBlock Name="TxtLoading" Text="Analyzing link... Please wait." FontSize="14" FontStyle="Italic" Foreground="#007ACC" Visibility="Collapsed" Margin="0,10,0,10" AutomationProperties.LiveSetting="Polite"/>

                        <!-- Configurations Form (Visible after analysis) -->
                        <StackPanel Name="PanelMediaConfig" Visibility="Collapsed" Margin="0,10,0,0">
                            
                            <!-- Video Info Card -->
                            <Border BorderBrush="#D6D6DB" BorderThickness="1" Background="#F8F8FA" CornerRadius="4" Padding="12" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="60" Height="45" Fill="#D6D6DB" Grid.Column="0" Margin="0,0,12,0"/> <!-- Static Thumbnail Placeholder -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Name="TxtMediaTitle" Text="Video Title" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Name="TxtMediaUploader" Text="Channel Uploader" Foreground="#666" Margin="0,2,0,0"/>
                                        <TextBlock Name="TxtMediaDuration" Text="Duration: 0:00" Foreground="#666" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Select Options Grid -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Download Type:" Target="{Binding ElementName=ComboType}"/>
                                <ComboBox Grid.Row="1" Grid.Column="0" Name="ComboType" Margin="0,0,10,0" SelectionChanged="ComboType_SelectionChanged">
                                    <ComboBoxItem Content="Video + Audio" IsSelected="True" Tag="video"/>
                                    <ComboBoxItem Content="Audio Only" Tag="audio"/>
                                </ComboBox>

                                <Label Grid.Row="0" Grid.Column="1" Content="File Format:" Target="{Binding ElementName=ComboFormat}"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Name="ComboFormat" Margin="0,0,10,0" SelectionChanged="ComboFormat_SelectionChanged"/>

                                <Label Grid.Row="0" Grid.Column="2" Content="Quality:" Target="{Binding ElementName=ComboQuality}"/>
                                <ComboBox Grid.Row="1" Grid.Column="2" Name="ComboQuality"/>
                            </Grid>

                            <!-- Save location -->
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <Label Grid.Row="0" Grid.ColumnSpan="2" Content="Save Location:" Target="{Binding ElementName=TxtSaveFolder}"/>
                                <TextBox Grid.Row="1" Grid.Column="0" Name="TxtSaveFolder" IsReadOnly="True" Focusable="False" Margin="0,0,10,0" Background="#F0F0F2"/>
                                <Button Grid.Row="1" Grid.Column="1" Name="BtnBrowseFolder" Content="Browse..." Click="BtnBrowseFolder_Click" AutomationProperties.Name="Browse Save Location Button"/>
                            </Grid>

                            <!-- Advanced Settings Subpanel (Managed by Expander/Toggle) -->
                            <GroupBox Name="GrpAdvanced" Header="Advanced Settings" Margin="0,20,0,10" Visibility="Collapsed">
                                <StackPanel>
                                    <!-- Partial Downloads Row -->
                                    <CheckBox Name="ChkPartial" Content="Download only a specific portion of this video" Checked="ChkPartial_Changed" Unchecked="ChkPartial_Changed" Margin="0,5,0,5"/>
                                    <Grid Name="PanelPartialTimes" Visibility="Collapsed" Margin="20,5,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <Label Content="Start Time (Format: hh:mm:ss or mm:ss):" Target="{Binding ElementName=TxtTimeStart}"/>
                                            <TextBox Name="TxtTimeStart" Text="00:00"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Label Content="End Time (Format: hh:mm:ss or mm:ss):" Target="{Binding ElementName=TxtTimeEnd}"/>
                                            <TextBox Name="TxtTimeEnd" Text="01:00"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Subtitle Options -->
                                    <CheckBox Name="ChkSubtitles" Content="Download subtitles" Checked="ChkSubtitles_Changed" Unchecked="ChkSubtitles_Changed" Margin="0,10,0,5"/>
                                    <StackPanel Name="PanelSubtitles" Visibility="Collapsed" Margin="20,5,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <Label Content="Language:" Target="{Binding ElementName=ComboSubLang}"/>
                                                <ComboBox Name="ComboSubLang">
                                                    <ComboBoxItem Content="English" IsSelected="True" Tag="en"/>
                                                    <ComboBoxItem Content="Spanish" Tag="es"/>
                                                    <ComboBoxItem Content="French" Tag="fr"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <Label Content="Subtitle Type:" Target="{Binding ElementName=ComboSubType}"/>
                                                <ComboBox Name="ComboSubType">
                                                    <ComboBoxItem Content="Manually Created Only" IsSelected="True" Tag="manual"/>
                                                    <ComboBoxItem Content="Include Auto-Generated" Tag="auto"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox Name="ChkEmbedSubtitles" Content="Embed subtitles inside output video file" Margin="0,10,0,0"/>
                                    </StackPanel>

                                    <!-- Embed Meta & Thumbnail -->
                                    <WrapPanel Margin="0,10,0,0">
                                        <CheckBox Name="ChkEmbedMetadata" Content="Embed media details/metadata" IsChecked="True" Margin="0,0,20,0"/>
                                        <CheckBox Name="ChkEmbedThumbnail" Content="Embed thumbnail/artwork artwork" IsChecked="True"/>
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <!-- Add Queue button -->
                            <Button Name="BtnAddToQueue" Content="Add to Download Queue" Style="{StaticResource SuccessButton}" FontSize="16" Height="40" Margin="0,20,0,10" Click="BtnAddToQueue_Click" AutomationProperties.Name="Add to Download Queue Button"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: QUEUE -->
            <TabItem Header="Download _Queue">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Name="TxtQueueHeader" Text="Active Download Queue" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Name="BtnClearCompleted" Content="Clear Completed" Margin="0,0,10,0" Click="BtnClearCompleted_Click"/>
                            <Button Name="BtnClearFailed" Content="Clear Failed" Click="BtnClearFailed_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Queue List View -->
                    <ListView Grid.Row="1" Name="ListQueue" HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#D6D6DB" BorderThickness="0,0,0,1" Padding="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Title -->
                                        <DockPanel Grid.Row="0">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" Width="400" HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding QualityLabel}" Foreground="#666" HorizontalAlignment="Right"/>
                                        </DockPanel>

                                        <!-- Progress details -->
                                        <Grid Grid.Row="1" Margin="0,6,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Status}" Foreground="#007ACC" FontWeight="SemiBold" Grid.Column="0" Width="90"/>
                                            <ProgressBar Value="{Binding Percent}" Minimum="0" Maximum="100" Height="14" Grid.Column="1" Margin="10,0,10,0"/>
                                            <TextBlock Text="{Binding Percent, StringFormat={}{0}%}" FontWeight="SemiBold" Grid.Column="2" Width="40" TextAlignment="Right"/>
                                        </Grid>

                                        <!-- Speed, ETA and Actions row -->
                                        <DockPanel Grid.Row="2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TotalSize, StringFormat={}Size: {0}}"/>
                                                <TextBlock Text=" | " Foreground="#CCC"/>
                                                <TextBlock Text="{Binding Speed, StringFormat={}Speed: {0}}"/>
                                                <TextBlock Text=" | " Foreground="#CCC"/>
                                                <TextBlock Text="{Binding Eta, StringFormat={}ETA: {0}}"/>
                                            </StackPanel>

                                            <!-- Error panel if failed -->
                                            <TextBlock Text="{Binding Error, StringFormat={}Error: {0}}" Foreground="Red" FontStyle="Italic" Margin="20,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="250" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Pause" Margin="0,0,5,0" Padding="6,2" Click="BtnPauseDownload_Click" Tag="{Binding Id}"/>
                                                <Button Content="Resume" Margin="0,0,5,0" Padding="6,2" Click="BtnResumeDownload_Click" Tag="{Binding Id}"/>
                                                <Button Content="Remove" Padding="6,2" Click="BtnRemoveDownload_Click" Tag="{Binding Id}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- TAB 3: HISTORY -->
            <TabItem Header="_History">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Completed Downloads Log" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Name="BtnClearHistory" Content="Clear History Log" HorizontalAlignment="Right" Click="BtnClearHistory_Click"/>
                    </DockPanel>

                    <!-- Search Filter -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Search logs:" Target="{Binding ElementName=TxtSearchHistory}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Name="TxtSearchHistory" Grid.Column="1" TextChanged="TxtSearchHistory_TextChanged" AutomationProperties.Name="Search Download History Box"/>
                    </Grid>

                    <!-- History Log Table -->
                    <DataGrid Grid.Row="2" Name="GridHistory" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="110"/>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="60"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTemplateColumn Header="Action" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Show in Folder" Click="BtnOpenHistoryFolder_Click" Padding="4,1" Margin="2" Tag="{Binding Location}" AutomationProperties.Name="Show file in folder"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 4: SETTINGS -->
            <TabItem Header="_Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        
                        <!-- Section 1: Save Paths -->
                        <GroupBox Header="Download Preferences">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Label Grid.Row="0" Grid.ColumnSpan="2" Content="Default Save Folder Location:" Target="{Binding ElementName=TxtDefaultFolder}"/>
                                    <TextBox Grid.Row="1" Grid.Column="0" Name="TxtDefaultFolder" IsReadOnly="True" Focusable="False" Margin="0,0,10,0" Background="#F0F0F2"/>
                                    <Button Grid.Row="1" Grid.Column="1" Name="BtnBrowseDefaultFolder" Content="Browse..." Click="BtnBrowseDefaultFolder_Click" AutomationProperties.Name="Browse default save location Button"/>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <Label Content="Default Video Quality:" Target="{Binding ElementName=ComboDefaultVideoQuality}"/>
                                        <ComboBox Name="ComboDefaultVideoQuality" SelectionChanged="ComboDefaultVideoQuality_Changed">
                                            <ComboBoxItem Content="Best Available Quality" IsSelected="True" Tag="best"/>
                                            <ComboBoxItem Content="Full HD (1080p)" Tag="1080"/>
                                            <ComboBoxItem Content="HD (720p)" Tag="720"/>
                                            <ComboBoxItem Content="Standard (480p)" Tag="480"/>
                                            <ComboBoxItem Content="Low (360p)" Tag="360"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <Label Content="Default Audio Format:" Target="{Binding ElementName=ComboDefaultAudioFormat}"/>
                                        <ComboBox Name="ComboDefaultAudioFormat" SelectionChanged="ComboDefaultAudioFormat_Changed">
                                            <ComboBoxItem Content="MP3 (.mp3)" IsSelected="True" Tag="mp3"/>
                                            <ComboBoxItem Content="M4A (.m4a)" Tag="m4a"/>
                                            <ComboBoxItem Content="WAV (.wav)" Tag="wav"/>
                                            <ComboBoxItem Content="FLAC (.flac)" Tag="flac"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <CheckBox Name="ChkSkipDuplicates" Content="Skip already downloaded files (Avoid duplicates)" IsChecked="True" Checked="ChkSkipDuplicates_Changed" Unchecked="ChkSkipDuplicates_Changed" Margin="0,15,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Section 2: Queue Constraints -->
                        <GroupBox Header="Queue & Concurrency Controls">
                            <StackPanel>
                                <Label Content="Maximum Simultaneous Downloads:" Target="{Binding ElementName=ComboSimultaneous}"/>
                                <ComboBox Name="ComboSimultaneous" Width="100" HorizontalAlignment="Left" SelectionChanged="ComboSimultaneous_Changed">
                                    <ComboBoxItem Content="1" Tag="1"/>
                                    <ComboBoxItem Content="2" IsSelected="True" Tag="2"/>
                                    <ComboBoxItem Content="3" Tag="3"/>
                                    <ComboBoxItem Content="4" Tag="4"/>
                                </ComboBox>
                                <TextBlock Text="Downloading too many files concurrently can cause YouTube to temporarily block your connection." Foreground="#666" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Section 3: Dependency Statuses -->
                        <GroupBox Header="Downloader Engine & Helper Tools">
                            <StackPanel>
                                <!-- yt-dlp status -->
                                <DockPanel Margin="0,5,0,10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="yt-dlp Engine" FontWeight="Bold"/>
                                        <TextBlock Name="TxtYtDlpStatus" Text="Status: Checking..." Foreground="#666"/>
                                    </StackPanel>
                                    <Button Name="BtnUpdateYtDlp" Content="Update Engine" HorizontalAlignment="Right" Click="BtnUpdateYtDlp_Click" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Separator Background="#E1E1E6" Margin="0,5,0,5"/>

                                <!-- FFmpeg status -->
                                <DockPanel Margin="0,10,0,5">
                                    <StackPanel VerticalAlignment="Center" Width="450">
                                        <TextBlock Text="FFmpeg Audio Helper (Required for HD merging & conversions)" FontWeight="Bold"/>
                                        <TextBlock Name="TxtFfmpegStatus" Text="Status: Checking..." Foreground="#666" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Name="BtnDownloadFfmpeg" Content="Download & Configure" HorizontalAlignment="Right" Click="BtnDownloadFfmpeg_Click" VerticalAlignment="Center"/>
                                </DockPanel>

                                <CheckBox Name="ChkAutoUpdate" Content="Automatically check for yt-dlp updates on startup" IsChecked="True" Checked="ChkAutoUpdate_Changed" Unchecked="ChkAutoUpdate_Changed" Margin="0,15,0,0"/>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
