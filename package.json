{
  "name": "youtube-downloader",
  "version": "1.0.0",
  "description": "An accessible, powerful YouTube video and audio downloader for Windows.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "keywords": [
    "youtube",
    "downloader",
    "accessible",
    "nvda",
    "jaws"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.accessible.youtubedownloader",
    "productName": "YouTube Accessible Downloader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YouTube Accessible Downloader"
    }
  }
}
